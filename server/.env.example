# ─── Google Maps (server-side, currently unused) ──────────────
GOOGLE_MAPS_API_KEY=

# ─── OpenSky Network (OAuth2) ────────────────────────────────
# Register: https://opensky-network.org/ → Login → OAuth → Create Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ─── NASA FIRMS (thermal anomalies / fire detection) ────────
# Register: https://firms.modaps.eosdis.nasa.gov/api/area/
# Optional — works without key at reduced rate limits
NASA_FIRMS_MAP_KEY=

# ─── AISStream.io (ship tracking) ─────────────────────────────
# Register: https://aisstream.io/ → API Keys
AISSTREAM_API_KEY=
