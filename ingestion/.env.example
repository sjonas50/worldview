# FalkorDB connection
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH=worldview_osint

# Express backend URL (use host.docker.internal when running in Docker)
BACKEND_URL=http://host.docker.internal:3001

# Ingestion intervals (seconds)
MIL_FLIGHT_POLL_INTERVAL=15
VESSEL_POLL_INTERVAL=60
FIRMS_POLL_INTERVAL=300
GDELT_POLL_INTERVAL=900
CORRELATION_INTERVAL=60

# GraphRAG LLM config (Anthropic Claude or OpenAI)
# LiteLLM format: anthropic/claude-sonnet-4-6 or openai/gpt-4.1
LLM_MODEL=anthropic/claude-sonnet-4-6
LLM_API_KEY=
GRAPHRAG_ENABLED=true
